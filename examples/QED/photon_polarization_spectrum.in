# Photon polarization spectrum and its dependence on the initial electron spin (QED module paper, Fig. 5):
# Stokes parameter xi_3 (linear polarization along e1 / e2) of the photons vs their energy, for electrons
# with gamma = 1e7 at chi = 0.1 (B = B_x = 0.0041492; fixed momentum and fixed spin) and the initial spins
#   unpol: no spin (s2 = 0, "random" spin),   par: s2 = +1 (along B),   anti: s2 = -1 (antiparallel to B)
# (e2 = +x for electrons moving along z in B_x). With mixed states every photon carries the expectation
# value xi = p_xi / (w + g s2), eq. 20, so xi_3(u) follows eq. 21:
#   xi_3(u) = (K_2/3(y) - u/(1-u) K_1/3(y) s2) / (w + g s2),   u = photon energy / (gamma m c^2)
# (paper: 0.5 at u -> 0; at 6e6 m c^2: 0.51, -0.35, 0.97 for s2 = 0, +1, -1).
# Photons above u ~ 0.3 are rare at chi = 0.1 (0.4 %; 1e-5 above u = 0.55), so every spin has two beams:
# X writes all its photons (1e4 electrons, ~1e5 photons) and X_tail (25 x more electrons) only those above
# 3e6 m c^2 (X_tail.photon_min_energy: the others are emitted and counted in qed.txt, not written).
# Output: photons_<beam>.bin (columns xi1 xi2 xi3). Run time ~1 min (2 cores).
# Analysis: python3 analyze.py polspec photon_polarization_spectrum.in out_polspec
units.n0_cm3 = 1.1e21
grid.type = uniform
grid.rmax = 4
grid.dr = 0.2
xi.min = 0
xi.max = 1
xi.step = 0.05
plasma.species = ions
ions.charge = 1
ions.mass = 1836
ions.mobile = 0
plasma.density(x,y,z) = "0"
qed.no_recoil = 1
qed.fixed_spin = 1
fields.external_B = 0.0041492 0 0
time.dt = 2500
time.steps = 100
beams = unpol par anti unpol_tail par_tail anti_tail
unpol.n0 = 1e-9
unpol.gamma = 1e7
unpol.sigma_r = 0.01
unpol.sigma_xi = 0.01
unpol.xi0 = 0.5
unpol.emit_n = 0
unpol.nparticles = 10000
unpol.passive = 1
unpol.scattering = 0
unpol.qed = 1
unpol.momentum_push = 0
par.n0 = 1e-9
par.gamma = 1e7
par.sigma_r = 0.01
par.sigma_xi = 0.01
par.xi0 = 0.5
par.emit_n = 0
par.nparticles = 10000
par.passive = 1
par.scattering = 0
par.qed = 1
par.momentum_push = 0
par.spin = 1 0 0
anti.n0 = 1e-9
anti.gamma = 1e7
anti.sigma_r = 0.01
anti.sigma_xi = 0.01
anti.xi0 = 0.5
anti.emit_n = 0
anti.nparticles = 10000
anti.passive = 1
anti.scattering = 0
anti.qed = 1
anti.momentum_push = 0
anti.spin = -1 0 0
unpol_tail.n0 = 1e-9
unpol_tail.gamma = 1e7
unpol_tail.sigma_r = 0.01
unpol_tail.sigma_xi = 0.01
unpol_tail.xi0 = 0.5
unpol_tail.emit_n = 0
unpol_tail.nparticles = 250000
unpol_tail.passive = 1
unpol_tail.scattering = 0
unpol_tail.qed = 1
unpol_tail.momentum_push = 0
unpol_tail.photon_min_energy = 3e6
par_tail.n0 = 1e-9
par_tail.gamma = 1e7
par_tail.sigma_r = 0.01
par_tail.sigma_xi = 0.01
par_tail.xi0 = 0.5
par_tail.emit_n = 0
par_tail.nparticles = 250000
par_tail.passive = 1
par_tail.scattering = 0
par_tail.qed = 1
par_tail.momentum_push = 0
par_tail.spin = 1 0 0
par_tail.photon_min_energy = 3e6
anti_tail.n0 = 1e-9
anti_tail.gamma = 1e7
anti_tail.sigma_r = 0.01
anti_tail.sigma_xi = 0.01
anti_tail.xi0 = 0.5
anti_tail.emit_n = 0
anti_tail.nparticles = 250000
anti_tail.passive = 1
anti_tail.scattering = 0
anti_tail.qed = 1
anti_tail.momentum_push = 0
anti_tail.spin = -1 0 0
anti_tail.photon_min_energy = 3e6
output.dir = out_polspec
output.every = 0
